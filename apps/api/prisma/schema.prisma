generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  INTERNAL_REVIEW
  SUBMISSION_PREPARATION
  UVP_PREPARATION
  SUBMITTED
  ADDITIONAL_INFORMATION_REQUEST
  APPROVED
  IN_IMPLEMENTATION
}

enum ProjectSubmissionType {
  GEWERBE
  AWG
  UVP_UVE
}

enum ChecklistItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  NOT_REQUIRED
}

enum ProjectAccessRole {
  PROJECT_VIEWER
  PROJECT_EDITOR
  EXTERNAL_PROJECT_VIEWER
  EXTERNAL_EXECUTOR
}

enum LegacyDecisionStatus {
  ARCHIVE_ONLY
  HISTORICALLY_RELEVANT
  PARTIALLY_RELEVANT
  NEEDS_REVIEW
  SUPERSEDED
  CONVERTED
}

enum LegacyDecisionReviewStatus {
  NOT_REVIEWED
  IN_REVIEW
  REVIEWED
}

enum BrandingAssetType {
  SIDEBAR_LOGO
  SIDEBAR_ICON
}

model User {
  id                            String                        @id @default(cuid())
  firstName                     String
  lastName                      String
  email                         String                        @unique
  phone                         String?
  role                          String
  type                          String
  titleOrPosition               String?
  department                    String?
  externalCompany               String?
  externalOrgId                 String?
  notes                         String?
  isArchived                    Boolean                       @default(false)
  passwordHash                  String
  passwordUpdatedAt             DateTime                      @default(now())
  lastPasswordResetAt           DateTime?
  mustChangePassword            Boolean                       @default(false)
  invitedAt                     DateTime?
  failedLoginCount              Int                           @default(0)
  lockedUntil                   DateTime?
  lastLoginAt                   DateTime?
  mfaEnabled                    Boolean                       @default(false)
  mfaEnforced                   Boolean                       @default(false)
  mfaTotpSecretEnc              String?
  mfaVerifiedAt                 DateTime?
  mfaRecoveryCodesHashJson      String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  sessions                      Session[]
  resetTokens                   PasswordResetToken[]
  receivedNotifications         NotificationOutbox[]          @relation("NotificationRecipient")
  triggeredNotificationAttempts NotificationDeliveryAttempt[] @relation("NotificationAttemptTriggerUser")
  mfaPendings                   MfaPending[]
  mfaChallenges                 MfaChallenge[]
  auditLogsAsActor              AuditLog[]                    @relation("AuditActor")
  auditLogsAsTarget             AuditLog[]                    @relation("AuditTarget")
  documentsCreated              Document[]
  documentApprovalRequests      DocumentApprovalRequest[]      @relation("DocumentApprovalRequestedBy")
  documentApprovalAssignments   DocumentApprovalRequest[]      @relation("DocumentApprovalApprover")
  documentApprovalDecisions     DocumentApprovalRequest[]      @relation("DocumentApprovalDecidedBy")
  documentApprovalEvents        DocumentApprovalEvent[]        @relation("DocumentApprovalEventActor")
  brandingAssetsUpdated         BrandingAsset[]              @relation("BrandingAssetUpdatedBy")
  externalOrg                   ExternalOrganization?         @relation(fields: [externalOrgId], references: [id], onDelete: SetNull)
  ownedProjects                 Project[]                     @relation("ProjectOwner")
  deputyProjects                Project[]                     @relation("ProjectDeputy")
  projectAccesses               ProjectAccess[]               @relation("ProjectAccessUser")
  grantedProjectAccesses        ProjectAccess[]               @relation("ProjectAccessGrantedBy")
  ownedObligations              Obligation[]                  @relation("ObligationOwner")
  deputyObligations             Obligation[]                  @relation("ObligationDeputy")
  externalObligations           Obligation[]                  @relation("ObligationExternalUser")
  ownedDeadlines                Deadline[]                    @relation("DeadlineOwner")
  deputyDeadlines               Deadline[]                    @relation("DeadlineDeputy")
  completedDeadlines            Deadline[]                    @relation("DeadlineCompletedBy")
  completedTaskStateEntries     TaskStateEntry[]              @relation("TaskStateCompletedBy")
  reviewedLegacyDecisions       LegacyDecision[]              @relation("LegacyDecisionReviewedBy")

  @@index([isArchived])
  @@index([role])
  @@index([type])
  @@index([externalOrgId])
}

model BrandingAsset {
  id          String            @id @default(cuid())
  type        BrandingAssetType @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  content     Bytes
  sha256      String
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  updatedBy   User?             @relation("BrandingAssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@index([updatedAt])
}

model Document {
  id               String   @id @default(cuid())
  ownerType        String
  ownerId          String
  category         String   @default("OTHER")
  fileVersion      Int      @default(1)
  filename         String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  storagePath      String
  sha256           String?
  isArchived       Boolean  @default(false)
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByUser    User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvalRequests DocumentApprovalRequest[]
  approvalEvents   DocumentApprovalEvent[]

  @@index([ownerType, ownerId])
  @@index([category])
  @@index([createdAt])
}

model DocumentApprovalRequest {
  id                String                  @id @default(cuid())
  documentId        String
  fileVersion       Int                     @default(1)
  status            String                  @default("PENDING")
  requestedByUserId String?
  requestedAt       DateTime                @default(now())
  requestedComment  String?
  approverUserId    String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionComment   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  document          Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedByUser   User?                   @relation("DocumentApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approverUser      User?                   @relation("DocumentApprovalApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  decidedByUser     User?                   @relation("DocumentApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  events            DocumentApprovalEvent[]

  @@index([documentId])
  @@index([documentId, fileVersion, createdAt])
  @@index([status])
  @@index([requestedByUserId])
  @@index([approverUserId])
  @@index([decidedByUserId])
}

model DocumentApprovalEvent {
  id                String                   @id @default(cuid())
  documentId        String
  approvalRequestId String?
  fileVersion       Int
  eventType         String
  status            String
  actorUserId       String?
  comment           String?
  createdAt         DateTime                 @default(now())
  document          Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvalRequest   DocumentApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  actorUser         User?                    @relation("DocumentApprovalEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([approvalRequestId])
  @@index([actorUserId])
  @@index([eventType])
}

model Comment {
  id              String            @id @default(cuid())
  entityType      String
  entityId        String
  authorUserId    String
  body            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isEdited        Boolean           @default(false)
  editedAt        DateTime?
  editedByUserId  String?
  deletedAt       DateTime?
  deletedByUserId String?
  revisions       CommentRevision[]

  @@index([entityType, entityId])
  @@index([authorUserId])
  @@index([deletedAt])
}

model CommentRevision {
  id              String   @id @default(cuid())
  commentId       String
  revisionNo      Int
  body            String
  createdAt       DateTime @default(now())
  createdByUserId String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, revisionNo])
  @@index([commentId])
}

model Role {
  id              String   @id @default(cuid())
  key             String   @unique
  labelDe         String
  descriptionDe   String?
  permissionsJson Json?
  isSystem        Boolean  @default(false)
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isArchived])
  @@index([labelDe])
}

model SecuritySettings {
  id                             String   @id
  passwordMinLength              Int      @default(12)
  passwordRequireNumberOrSpecial Boolean  @default(true)
  maxFailedLoginAttempts         Int      @default(5)
  lockoutMinutes                 Int      @default(15)
  sessionTtlDays                 Int      @default(7)
  allowExternalUsers             Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model ExternalOrganization {
  id          String       @id @default(cuid())
  name        String       @unique
  type        String
  phone       String?
  email       String?
  address     String?
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  obligations Obligation[] @relation("ObligationExternalOrg")

  @@index([isArchived])
  @@index([type])
}

model Company {
  id         String     @id @default(cuid())
  name       String
  shortName  String?
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  sites      Site[]
  facilities Facility[]
  projects   Project[]

  @@index([isArchived])
}

model Site {
  id         String     @id @default(cuid())
  companyId  String
  name       String
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilities Facility[]
  projects   Project[]

  @@index([companyId])
  @@index([isArchived])
}

model Facility {
  id         String    @id @default(cuid())
  companyId  String
  siteId     String
  name       String
  type       String?
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  projects   Project[]

  @@index([companyId])
  @@index([siteId])
  @@index([isArchived])
}

model Authority {
  id         String             @id @default(cuid())
  name       String
  shortName  String?
  isArchived Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  contacts   AuthorityContact[]
  legalDocs  LegalDocument[]
  projects   Project[]
  deadlines  Deadline[]
  legacyDecisions LegacyDecision[]

  @@index([isArchived])
}

model AuthorityContact {
  id          String          @id @default(cuid())
  authorityId String
  name        String
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  mobile      String?
  roleTitle   String?
  notes       String?
  department  String?
  isPrimary   Boolean         @default(false)
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  authority   Authority       @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  legalDocs   LegalDocument[]
  projects    Project[]

  @@index([authorityId])
  @@index([isArchived])
}

model Project {
  id                   String                 @id
  title                String
  status               ProjectStatus?
  submissionType       ProjectSubmissionType?
  submissionTypeId     String?
  shortDescription     String?
  detailedDescription  String?                @db.Text
  authorityRef         String?
  companyId            String
  siteId               String?
  facilityId           String?
  authorityId          String?
  authorityContactId   String?
  ownerUserId          String?
  deputyUserId         String?
  participantUserIds   Json
  internalParticipants Json
  externalParticipants Json
  attachments          Json
  dependsOnProjectIds  Json
  referenceLegalDocIds Json
  archivedAt           DateTime?
  isArchived           Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  company              Company                @relation(fields: [companyId], references: [id])
  checklist            ProjectChecklist?
  legalDocuments       LegalDocument[]
  deadlines            Deadline[]
  site                 Site?                  @relation(fields: [siteId], references: [id])
  facility             Facility?              @relation(fields: [facilityId], references: [id])
  authority            Authority?             @relation(fields: [authorityId], references: [id])
  authorityContact     AuthorityContact?      @relation(fields: [authorityContactId], references: [id])
  ownerUser            User?                  @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  deputyUser           User?                  @relation("ProjectDeputy", fields: [deputyUserId], references: [id])
  submissionTypeRef    SubmissionType?        @relation("ProjectSubmissionTypeRef", fields: [submissionTypeId], references: [id], onDelete: SetNull)
  accessEntries        ProjectAccess[]
  legacyDecisions      LegacyDecision[]

  @@index([companyId])
  @@index([siteId])
  @@index([facilityId])
  @@index([authorityId])
  @@index([authorityContactId])
  @@index([ownerUserId])
  @@index([deputyUserId])
  @@index([submissionType])
  @@index([submissionTypeId])
  @@index([isArchived])
}

model LegalMatter {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String           @unique
  shortName       String?
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  badgeVariant    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissionTypes SubmissionType[]

  @@index([isActive, sortOrder])
  @@index([sortOrder])
}

model ProcedureType {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String           @unique
  shortName       String?
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissionTypes SubmissionType[]

  @@index([isActive, sortOrder])
  @@index([sortOrder])
}

model SubmissionType {
  id                  String          @id @default(cuid())
  code                String          @unique
  name                String          @unique
  shortName           String?
  description         String?         @db.Text
  legalMatterId       String
  procedureTypeId     String
  isActive            Boolean         @default(true)
  isLegacy            Boolean         @default(false)
  sortOrder           Int             @default(0)
  badgeVariant        String?
  legacyAliases       Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  legalMatter         LegalMatter     @relation(fields: [legalMatterId], references: [id], onDelete: Restrict)
  procedureType       ProcedureType   @relation(fields: [procedureTypeId], references: [id], onDelete: Restrict)
  projects            Project[]       @relation("ProjectSubmissionTypeRef")

  @@index([legalMatterId])
  @@index([procedureTypeId])
  @@index([isActive, sortOrder])
  @@index([sortOrder])
}

model ProjectAccess {
  id              String            @id @default(cuid())
  projectId       String
  userId          String
  accessRole      ProjectAccessRole
  note            String?
  grantedByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User              @relation("ProjectAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser   User?             @relation("ProjectAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([accessRole])
}

model ProjectChecklist {
  id        String                    @id
  projectId String                    @unique
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections  ProjectChecklistSection[]
}

model ProjectChecklistSection {
  id                 String                 @id
  projectChecklistId String
  title              String
  description        String?
  sortOrder          Int
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  checklist          ProjectChecklist       @relation(fields: [projectChecklistId], references: [id], onDelete: Cascade)
  items              ProjectChecklistItem[]

  @@index([projectChecklistId, sortOrder])
}

model ProjectChecklistItem {
  id                        String                  @id
  projectChecklistSectionId String
  title                     String
  description               String?
  status                    ChecklistItemStatus
  sortOrder                 Int
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  section                   ProjectChecklistSection @relation(fields: [projectChecklistSectionId], references: [id], onDelete: Cascade)

  @@index([projectChecklistSectionId, sortOrder])
}

model LegalDocument {
  id                 String            @id
  projectId          String
  type               String
  title              String
  shortDescription   String?
  detailedDescription  String?           @db.Text
  contentSummary       String?           @db.Text
  reference          String?
  issuedAt           String?
  authorityId        String?
  authorityContactId String?
  attachments        Json
  aiExtraction       Json?
  scopeOverride      Json?
  archivedAt         DateTime?
  isArchived         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authority          Authority?        @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  authorityContact   AuthorityContact? @relation(fields: [authorityContactId], references: [id], onDelete: SetNull)
  obligations        Obligation[]
  deadlines          Deadline[]
  linkedLegacyDecisions LegacyDecision[] @relation("LegacyDecisionLinkedLegalDoc")
  supersededLegacyDecisions LegacyDecision[] @relation("LegacyDecisionSupersededByLegalDoc")

  @@index([projectId])
  @@index([authorityId])
  @@index([authorityContactId])
  @@index([isArchived])
}

model LegacyDecision {
  id                    String                     @id
  projectId             String
  title                 String
  fileNumber            String?
  authorityId           String?
  authorityName         String?
  issuedAt              String?
  validFrom             String?
  validUntil            String?
  legacyStatus          LegacyDecisionStatus       @default(ARCHIVE_ONLY)
  reviewStatus          LegacyDecisionReviewStatus @default(NOT_REVIEWED)
  relevanceNote         String?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  linkedLegalDocId      String?
  supersededByLegalDocId String?
  archivedAt            DateTime?
  isArchived            Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  project               Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authority             Authority?                 @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  reviewedByUser        User?                      @relation("LegacyDecisionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  linkedLegalDoc        LegalDocument?             @relation("LegacyDecisionLinkedLegalDoc", fields: [linkedLegalDocId], references: [id], onDelete: SetNull)
  supersededByLegalDoc  LegalDocument?             @relation("LegacyDecisionSupersededByLegalDoc", fields: [supersededByLegalDocId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([authorityId])
  @@index([reviewedByUserId])
  @@index([linkedLegalDocId])
  @@index([supersededByLegalDocId])
  @@index([legacyStatus])
  @@index([reviewStatus])
  @@index([isArchived])
}

model Obligation {
  id                      String                @id
  legalDocId              String
  title                   String
  infoTextLong            String?
  level                   String
  criticality             String?
  scheduleType            String
  firstDueDate            String?
  recurrenceEndDate       String?
  intervalUnit            String?
  intervalValue           Int?
  ownerUserId             String?
  deputyUserId            String?
  externalOrgId           String?
  externalUserId          String?
  origin                  String?
  sourceSuggestionId      String?
  sourceRunId             String?
  emailReminderEnabled    Boolean               @default(false)
  emailReminderDaysBefore Int?
  evidenceRequirements    Json
  archivedAt              DateTime?
  isArchived              Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  legalDocument           LegalDocument         @relation(fields: [legalDocId], references: [id], onDelete: Cascade)
  ownerUser               User?                 @relation("ObligationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deputyUser              User?                 @relation("ObligationDeputy", fields: [deputyUserId], references: [id], onDelete: SetNull)
  externalOrg             ExternalOrganization? @relation("ObligationExternalOrg", fields: [externalOrgId], references: [id], onDelete: SetNull)
  externalUser            User?                 @relation("ObligationExternalUser", fields: [externalUserId], references: [id], onDelete: SetNull)

  @@index([legalDocId])
  @@index([ownerUserId])
  @@index([deputyUserId])
  @@index([externalOrgId])
  @@index([externalUserId])
  @@index([isArchived])
}

model Deadline {
  id                      String         @id
  title                   String
  description             String?
  dueDate                 String
  status                  String
  projectId               String?
  legalDocId              String?
  authorityId             String?
  ownerUserId             String?
  deputyUserId            String?
  emailReminderEnabled    Boolean        @default(false)
  emailReminderDaysBefore Int?
  completedAt             DateTime?
  completedByUserId       String?
  evidence                Json
  archivedAt              DateTime?
  isArchived              Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  project                 Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  legalDocument           LegalDocument? @relation(fields: [legalDocId], references: [id], onDelete: SetNull)
  authority               Authority?     @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  ownerUser               User?          @relation("DeadlineOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deputyUser              User?          @relation("DeadlineDeputy", fields: [deputyUserId], references: [id], onDelete: SetNull)
  completedByUser         User?          @relation("DeadlineCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([legalDocId])
  @@index([authorityId])
  @@index([ownerUserId])
  @@index([deputyUserId])
  @@index([completedByUserId])
  @@index([status])
  @@index([dueDate])
  @@index([isArchived])
}

model TaskStateEntry {
  taskInstanceId    String    @id
  status            String
  completedAt       DateTime?
  completedByUserId String?
  completedByLabel  String?
  evidence          Json
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedByUser   User?     @relation("TaskStateCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([completedByUserId])
  @@index([status])
  @@index([updatedAt])
}

model MfaPending {
  id        String   @id @default(cuid())
  userId    String
  secretEnc String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipHash    String?
  uaHash    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model NotificationOutbox {
  id                String                        @id @default(cuid())
  eventType         String
  entityType        String?
  entityId          String?
  recipientUserId   String?
  recipientEmail    String
  recipientName     String?
  subject           String
  payloadJson       Json
  status            String                        @default("PENDING")
  scheduledFor      DateTime                      @default(now())
  claimedAt         DateTime?
  claimToken        String?
  sentAt            DateTime?
  attemptCount      Int                           @default(0)
  lastAttemptAt     DateTime?
  lastError         String?
  providerReference String?
  idempotencyKey    String                        @unique
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  recipientUser     User?                         @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  deliveryAttempts  NotificationDeliveryAttempt[]

  @@index([status, scheduledFor])
  @@index([claimedAt])
  @@index([recipientUserId, createdAt])
  @@index([entityType, entityId])
}

model NotificationDeliveryAttempt {
  id                String             @id @default(cuid())
  notificationId    String
  attemptNumber     Int
  outcome           String
  startedAt         DateTime
  finishedAt        DateTime
  httpStatus        Int?
  errorSummary      String?
  providerReference String?
  triggeredByUserId String?
  createdAt         DateTime           @default(now())
  notification      NotificationOutbox @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  triggeredByUser   User?              @relation("NotificationAttemptTriggerUser", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([notificationId, createdAt])
  @@index([outcome, createdAt])
  @@index([triggeredByUserId])
}

model NotificationSettings {
  id                        String   @id
  defaultDueSoonDays        Int      @default(7)
  deadlineDueSoonEnabled    Boolean  @default(true)
  assignmentAssignedEnabled Boolean  @default(true)
  dailyDigestEnabled        Boolean  @default(false)
  weeklyDigestEnabled       Boolean  @default(false)
  dailyDigestHourLocal      Int      @default(7)
  weeklyDigestWeekday       Int      @default(1)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model NotificationWorkerStatus {
  workerKey          String    @id
  lastStartedAt      DateTime?
  lastFinishedAt     DateTime?
  lastSuccessfulAt   DateTime?
  lastOutcome        String?
  lastError          String?
  lastClaimedCount   Int       @default(0)
  lastProcessedCount Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  action       String
  ip           String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model PortalSnapshot {
  id              String   @id @default(cuid())
  scopeKey        String   @unique
  payload         Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
