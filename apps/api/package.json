{
  "name": "@nemetz/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "DATABASE_URL=\"file:./test.db\" prisma db push --skip-generate --accept-data-loss && DATABASE_URL=\"file:./test.db\" NODE_ENV=test tsx --test --test-concurrency=1 src/**/*.test.ts",
    "prisma": "prisma",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "openid-client": "^5.7.1",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "prisma": "^5.9.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
