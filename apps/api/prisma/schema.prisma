generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String                @unique
  phone                    String?
  role                     String
  type                     String
  titleOrPosition          String?
  department               String?
  externalCompany          String?
  externalOrgId            String?
  notes                    String?
  isArchived               Boolean               @default(false)
  passwordHash             String
  passwordUpdatedAt        DateTime              @default(now())
  lastPasswordResetAt      DateTime?
  mustChangePassword       Boolean               @default(false)
  invitedAt                DateTime?
  failedLoginCount         Int                   @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  mfaEnabled               Boolean               @default(false)
  mfaEnforced              Boolean               @default(false)
  mfaTotpSecretEnc         String?
  mfaVerifiedAt            DateTime?
  mfaRecoveryCodesHashJson String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  sessions                 Session[]
  resetTokens              PasswordResetToken[]
  mfaPendings              MfaPending[]
  mfaChallenges            MfaChallenge[]
  auditLogsAsActor         AuditLog[]            @relation("AuditActor")
  auditLogsAsTarget        AuditLog[]            @relation("AuditTarget")
  documentsCreated         Document[]
  externalOrg              ExternalOrganization? @relation(fields: [externalOrgId], references: [id], onDelete: SetNull)
  ownedProjects            Project[]             @relation("ProjectOwner")
  deputyProjects           Project[]             @relation("ProjectDeputy")
  ownedObligations         Obligation[]          @relation("ObligationOwner")
  deputyObligations        Obligation[]          @relation("ObligationDeputy")
  ownedDeadlines           Deadline[]            @relation("DeadlineOwner")
  deputyDeadlines          Deadline[]            @relation("DeadlineDeputy")
  completedDeadlines       Deadline[]            @relation("DeadlineCompletedBy")
  completedTaskStateEntries TaskStateEntry[]       @relation("TaskStateCompletedBy")

  @@index([isArchived])
  @@index([role])
  @@index([type])
  @@index([externalOrgId])
}

model Document {
  id               String   @id @default(cuid())
  ownerType        String
  ownerId          String
  filename         String
  originalFilename String?
  mimeType         String
  sizeBytes        Int
  storagePath      String
  sha256           String?
  isArchived       Boolean  @default(false)
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByUser    User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([createdAt])
}

model Comment {
  id              String            @id @default(cuid())
  entityType      String
  entityId        String
  authorUserId    String
  body            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isEdited        Boolean           @default(false)
  editedAt        DateTime?
  editedByUserId  String?
  deletedAt       DateTime?
  deletedByUserId String?
  revisions       CommentRevision[]

  @@index([entityType, entityId])
  @@index([authorUserId])
  @@index([deletedAt])
}

model CommentRevision {
  id              String   @id @default(cuid())
  commentId       String
  revisionNo      Int
  body            String
  createdAt       DateTime @default(now())
  createdByUserId String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, revisionNo])
  @@index([commentId])
}

model Role {
  id            String   @id @default(cuid())
  key           String   @unique
  labelDe       String
  descriptionDe String?
  isSystem      Boolean  @default(false)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isArchived])
  @@index([labelDe])
}

model ExternalOrganization {
  id         String   @id @default(cuid())
  name       String   @unique
  type       String
  phone      String?
  email      String?
  address    String?
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]

  @@index([isArchived])
  @@index([type])
}

model Company {
  id         String     @id @default(cuid())
  name       String
  shortName  String?
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  sites      Site[]
  facilities Facility[]
  projects   Project[]

  @@index([isArchived])
}

model Site {
  id         String     @id @default(cuid())
  companyId  String
  name       String
  isArchived Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilities Facility[]
  projects   Project[]

  @@index([companyId])
  @@index([isArchived])
}

model Facility {
  id         String    @id @default(cuid())
  companyId  String
  siteId     String
  name       String
  type       String?
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  projects   Project[]

  @@index([companyId])
  @@index([siteId])
  @@index([isArchived])
}

model Authority {
  id         String             @id @default(cuid())
  name       String
  shortName  String?
  isArchived Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  contacts   AuthorityContact[]
  legalDocs  LegalDocument[]
  projects   Project[]
  deadlines  Deadline[]

  @@index([isArchived])
}

model AuthorityContact {
  id          String          @id @default(cuid())
  authorityId String
  name        String
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  mobile      String?
  roleTitle   String?
  notes       String?
  department  String?
  isPrimary   Boolean         @default(false)
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  authority   Authority       @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  legalDocs   LegalDocument[]
  projects    Project[]

  @@index([authorityId])
  @@index([isArchived])
}

model Project {
  id                   String            @id
  title                String
  shortDescription     String?
  authorityRef         String?
  companyId            String
  siteId               String?
  facilityId           String?
  authorityId          String?
  authorityContactId   String?
  ownerUserId          String?
  deputyUserId         String?
  participantUserIds   Json
  internalParticipants Json
  externalParticipants Json
  attachments          Json
  dependsOnProjectIds  Json
  referenceLegalDocIds Json
  archivedAt           DateTime?
  isArchived           Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  company              Company           @relation(fields: [companyId], references: [id])
  legalDocuments       LegalDocument[]
  deadlines            Deadline[]
  site                 Site?             @relation(fields: [siteId], references: [id])
  facility             Facility?         @relation(fields: [facilityId], references: [id])
  authority            Authority?        @relation(fields: [authorityId], references: [id])
  authorityContact     AuthorityContact? @relation(fields: [authorityContactId], references: [id])
  ownerUser            User?             @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  deputyUser           User?             @relation("ProjectDeputy", fields: [deputyUserId], references: [id])

  @@index([companyId])
  @@index([siteId])
  @@index([facilityId])
  @@index([authorityId])
  @@index([authorityContactId])
  @@index([ownerUserId])
  @@index([deputyUserId])
  @@index([isArchived])
}

model LegalDocument {
  id                 String            @id
  projectId          String
  type               String
  title              String
  shortDescription   String?
  reference          String?
  issuedAt           String?
  authorityId        String?
  authorityContactId String?
  attachments        Json
  aiExtraction       Json?
  scopeOverride      Json?
  archivedAt         DateTime?
  isArchived         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authority          Authority?        @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  authorityContact   AuthorityContact? @relation(fields: [authorityContactId], references: [id], onDelete: SetNull)
  obligations        Obligation[]
  deadlines          Deadline[]

  @@index([projectId])
  @@index([authorityId])
  @@index([authorityContactId])
  @@index([isArchived])
}

model Obligation {
  id                      String        @id
  legalDocId              String
  title                   String
  infoTextLong            String?
  level                   String
  criticality             String?
  scheduleType            String
  firstDueDate            String?
  intervalUnit            String?
  intervalValue           Int?
  ownerUserId             String?
  deputyUserId            String?
  origin                  String?
  sourceSuggestionId      String?
  sourceRunId             String?
  emailReminderEnabled    Boolean       @default(false)
  emailReminderDaysBefore Int?
  evidenceRequirements    Json
  archivedAt              DateTime?
  isArchived              Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  legalDocument           LegalDocument @relation(fields: [legalDocId], references: [id], onDelete: Cascade)
  ownerUser               User?         @relation("ObligationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deputyUser              User?         @relation("ObligationDeputy", fields: [deputyUserId], references: [id], onDelete: SetNull)

  @@index([legalDocId])
  @@index([ownerUserId])
  @@index([deputyUserId])
  @@index([isArchived])
}

model Deadline {
  id                      String        @id
  title                   String
  description             String?
  dueDate                 String
  status                  String
  projectId               String?
  legalDocId              String?
  authorityId             String?
  ownerUserId             String?
  deputyUserId            String?
  emailReminderEnabled    Boolean       @default(false)
  emailReminderDaysBefore Int?
  completedAt             DateTime?
  completedByUserId       String?
  evidence                Json
  archivedAt              DateTime?
  isArchived              Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  project                 Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  legalDocument           LegalDocument? @relation(fields: [legalDocId], references: [id], onDelete: SetNull)
  authority               Authority?    @relation(fields: [authorityId], references: [id], onDelete: SetNull)
  ownerUser               User?         @relation("DeadlineOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  deputyUser              User?         @relation("DeadlineDeputy", fields: [deputyUserId], references: [id], onDelete: SetNull)
  completedByUser         User?         @relation("DeadlineCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([legalDocId])
  @@index([authorityId])
  @@index([ownerUserId])
  @@index([deputyUserId])
  @@index([completedByUserId])
  @@index([status])
  @@index([dueDate])
  @@index([isArchived])
}

model TaskStateEntry {
  taskInstanceId    String   @id
  status            String
  completedAt       DateTime?
  completedByUserId String?
  completedByLabel  String?
  evidence          Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  completedByUser   User?    @relation("TaskStateCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([completedByUserId])
  @@index([status])
  @@index([updatedAt])
}

model MfaPending {
  id        String   @id @default(cuid())
  userId    String
  secretEnc String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MfaChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipHash    String?
  uaHash    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  action       String
  ip           String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model PortalSnapshot {
  id              String   @id @default(cuid())
  scopeKey        String   @unique
  payload         Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
